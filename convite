<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Convite Isabela Sophia - Carta Animada</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{
min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
font-family:'Poppins', 'Segoe UI', Arial, sans-serif;
background: linear-gradient(135deg,#fce8f1,#fee4e8 50%,#ffeef1);
color:#333;
}

.wrapper{
text-align:center;
}
.title{
margin-bottom:1rem;
font-size:1.2rem;
font-weight:700;
color:#8d1240;
}

.envelope-container{
width:320px;
height:220px;
position:relative;
perspective:1400px;
margin:auto;
}
.envelope{
width:100%;
height:100%;
position:absolute;
transform-style:preserve-3d;
transition:transform .8s cubic-bezier(0.22,1,0.36,1);
cursor:pointer;
}
.envelope-container:hover .envelope{
transform: translateY(-6px) scale(1.02);
}
.envelope.shake{
animation: shake 0.35s cubic-bezier(0.36, 0.07, 0.19, 0.97);
}

@keyframes shake {
  0% { transform: translateX(0); }
  15% { transform: translateX(-8px); }
  30% { transform: translateX(8px); }
  45% { transform: translateX(-6px); }
  60% { transform: translateX(6px); }
  75% { transform: translateX(-3px); }
  100% { transform: translateX(0); }
}

.envelope-container:hover .envelope-flap{ animation: flapPulse 0.8s ease-in-out infinite alternate; }

@keyframes flapPulse {
  0%, 100% { transform: rotateX(0deg); }
  50% { transform: rotateX(4deg); }
}

.envelope-outer,
.envelope-flap,
.letter-front{
position:absolute;
left:0;
top:0;
width:100%;
height:100%;
border-radius:14px;
box-shadow:0 16px 30px rgba(0,0,0,0.25);
}
.envelope-outer{
background:#ff8dc7;
}
.envelope-flap{
background:#ff5f9a;
transform-origin:top;
transform:rotateX(0deg);
transition:transform .7s ease;
clip-path: polygon(0 0, 100% 0, 50% 50%);
}
.envelope.open .envelope-flap{
transform:rotateX(-180deg);
}

.letter{
position:absolute;
left:12px;
top:42px;
width:calc(100% - 24px);
height:calc(100% - 54px);
background:#fff;
border-radius:10px;
box-shadow:0 8px 20px rgba(0,0,0,0.15);
transform: translateY(18px) scale(0.96);
opacity:0;
transition:all .6s ease;
padding:20px;
text-align:center;
}
.envelope.open .letter{
transform: translateY(0) scale(1);
opacity:1;
transition-delay:.15s;
}

.letter h2{margin-bottom:0.4rem;font-size:1.1rem;color:#c71a6d;}
.letter p{margin-bottom:0.8rem;font-size:0.95rem;line-height:1.4;font-weight:500;color:#555;}
.message{font-size:0.9rem;color:#777;margin-bottom:1rem;}
.confirm-btn{
background:#d9197e;color:#fff;border:none;padding:0.75rem 1.3rem;border-radius:999px;
font-weight:700;cursor:pointer;opacity:0;transform: translateY(8px);
transition:all .4s ease;
}
.confirm-btn.visible{opacity:1;transform: translateY(0);}
.confirm-btn:hover{background:#b00f63;}
.confirm-btn.confirmed{background:#28a745;box-shadow:0 5px 12px rgba(40,167,69,.4);}

.confetti-container{
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
pointer-events:none;
overflow:hidden;
}
.confetti-piece{
position:absolute;
width:8px;
height:12px;
background:magenta;
opacity:0.9;
transform-origin:center;
animation: confetti-fall 1.8s ease-out forwards;
}
@keyframes confetti-fall {
  0% { opacity:1; transform: translateY(0) rotate(0deg); }
  100% { opacity:0; transform: translateY(260px) rotate(720deg); }
}

.status{
margin-top:1rem;font-size:0.9rem;color:#5a0f45;
}

</style>
</head>
<body>
<div class="wrapper">
<div class="title">Método PROFISSIONAL ✉️✨ - Convite Interativo</div>
<div class="envelope-container" id="envelopeContainer" role="button" aria-label="Abrir convite" tabindex="0">
<div class="envelope" id="envelope">
<div class="envelope-outer"></div>
<div class="envelope-flap"></div>
<div class="letter">
<h2>🎉 Convite Especial</h2>
<p>Você foi convidado para o aniversário da <strong>Isabela Sophia</strong>.</p>
<p class="message">Toque/click na carta para abrir e confirmar presença.</p>
<button class="confirm-btn" id="confirmBtn">Confirmar Presença</button>
</div>
</div>
</div>
<div class="confetti-container" id="confettiContainer"></div>
<div class="status" id="statusText">Carta fechada. Clique para abrir.</div>
</div>

<script>
const envelope = document.getElementById('envelope');
const container = document.getElementById('envelopeContainer');
const button = document.getElementById('confirmBtn');
const statusText = document.getElementById('statusText');
const confettiRoot = document.getElementById('confettiContainer');
const confirmedKey = 'presencaConfirmada2026';

function setConfirmedVisual(){
  envelope.classList.add('open');
  button.classList.add('visible','confirmed');
  button.disabled = true;
  button.textContent = 'Confirmado';
  statusText.textContent = '✅ Presença confirmada! Obrigado.';
}

function resetEnvelope(){
  envelope.classList.remove('open');
  button.classList.remove('visible');
  if (!localStorage.getItem(confirmedKey)) {
    button.disabled = false;
    button.classList.remove('confirmed');
    button.textContent = 'Confirmar Presença';
    statusText.textContent = 'Carta fechada. Clique para abrir.';
  }
}

function confetti(){
  const colors = ['#f72585','#7209b7','#3a0ca3','#4361ee','#4cc9f0','#f25c54','#ffc300'];
  for (let i = 0; i < 80; i++) {
    const piece = document.createElement('div');
    piece.className = 'confetti-piece';
    piece.style.background = colors[Math.floor(Math.random()*colors.length)];
    piece.style.left = Math.random()*100 + '%';
    piece.style.top = '-10px';
    piece.style.opacity = String((Math.random()*.5)+.8);
    piece.style.transform = `rotate(${Math.random()*360}deg)`;
    piece.style.animationDuration = (1.3 + Math.random()*0.8)+'s';
    piece.style.animationDelay = (Math.random()*0.4)+'s';
    piece.style.width = (6 + Math.random()*8)+'px';
    piece.style.height = (8 + Math.random()*10)+'px';
    confettiRoot.appendChild(piece);
    setTimeout(()=> piece.remove(), 2200);
  }
}

function shakeEnvelope(){
  envelope.classList.add('shake');
  setTimeout(()=> envelope.classList.remove('shake'), 380);
}

function toggleEnvelope(){
  if (localStorage.getItem(confirmedKey) === 'true') return;
  if (envelope.classList.contains('open')) {
    envelope.classList.remove('open');
    button.classList.remove('visible');
    statusText.textContent = 'Carta fechada. Clique para abrir.';
  } else {
    shakeEnvelope();
    setTimeout(() => {
      envelope.classList.add('open');
      statusText.textContent = 'Carta aberta! Clique em Confirmar Presença.';
      button.classList.add('visible');
    }, 360);
  }
}

function confirmarPresenca(event){
  event.stopPropagation();
  button.disabled = true;
  button.textContent = 'Confirmando...';
  statusText.textContent = 'Enviando confirmação...';

  fetch('/whisper/confirm-presenca', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({evento:'Aniversário Isabela Sophia', data:'2026-04'})
  })
  .then(response => {
    if (!response.ok) throw new Error('Não foi possível confirmar');
    return response.json().catch(()=>({status:'ok'}));
  })
  .then(() => {
    localStorage.setItem(confirmedKey, 'true');
    setConfirmedVisual();
    confetti();
  })
  .catch(() => {
    // fallback local mesmo sem rota de backend
    localStorage.setItem(confirmedKey, 'true');
    setConfirmedVisual();
    statusText.textContent = '✅ Presença confirmada! (offline)';
    confetti();
  });
}

window.addEventListener('load', () => {
  if (localStorage.getItem(confirmedKey) === 'true') {
    setConfirmedVisual();
    statusText.textContent = '✅ Presença já confirmada anteriormente.';
  }
});

container.addEventListener('click', toggleEnvelope);
container.addEventListener('keydown', function(event){
  if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleEnvelope(); }
});
button.addEventListener('click', confirmarPresenca);
</script>
</body>
</html>
